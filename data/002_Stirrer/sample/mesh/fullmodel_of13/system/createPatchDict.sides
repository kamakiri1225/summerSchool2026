FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// topoSet で抜き出した両放射側面を、名前付きパッチ side_0deg / side_60deg
// にする（defaultFaces から取り出す）。回転コピー後の stitchMesh で、この
// 2パッチ同士を貼り合わせて内部面に戻す。

pointSync false;

patches
(
    { name side_0deg;  patchInfo { type patch; } constructFrom set; set side0Faces; }
    { name side_60deg; patchInfo { type patch; } constructFrom set; set side60Faces; }
);

// ************************************************************************* //
