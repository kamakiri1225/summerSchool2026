// OpenFOAM13(Foundation版)では dynamicFvMesh/motionSolverLibs ではなく
// mover{ type motionSolver; ... } の構文を使う。

mover
{
    type            motionSolver;

    libs            ("libfvMotionSolvers.so");

    motionSolver    displacementSBRStress;

    diffusivity     quadratic inverseDistance ("wall_wing.*");
}

