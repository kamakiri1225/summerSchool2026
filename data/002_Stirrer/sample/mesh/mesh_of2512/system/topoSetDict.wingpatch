FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// ESI版 ideasUnvToFoam は UNV の2Dシート要素(羽根)を境界面(defaultFaces)に
// 変換する。そこで defaultFaces から羽根位置の境界面を拾い、createPatch で
// wall_wing / wall_wing2 パッチへ移す(Foundation版の createBaffles 相当)。
// boxToFace の y 幅は座標丸め対策で ±1e-6 とする。

actions
(
    {
        name    wingPatchFaces;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { patch defaultFaces; }
    }
    {
        name    wingPatchFaces;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo { box (0.00999 -1e-05 0.01249) (0.02501 1e-05 0.01751); }
    }

    {
        name    wingPatchFaces2;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { patch defaultFaces; }
    }
    {
        name    wingPatchFaces2;
        type    faceSet;
        action  subset;
        source  boxToFace;
        sourceInfo { box (0.00999 -1e-05 0.03249) (0.02501 1e-05 0.03751); }
    }
);

// ************************************************************************* //
