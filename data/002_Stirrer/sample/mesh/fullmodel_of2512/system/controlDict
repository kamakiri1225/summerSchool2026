FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     moveDynamicMesh;

startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         1;
deltaT          0.1;

writeControl    timeStep;
writeInterval   1;
writeFormat     ascii;
writePrecision  12;
timeFormat      general;
timePrecision   6;

