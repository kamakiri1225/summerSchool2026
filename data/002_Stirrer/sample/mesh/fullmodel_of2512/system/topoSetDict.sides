FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      topoSetDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// 1/6セクター(θ=0〜60°)の両放射側面を faceSet として抜き出す。
// defaultFaces に限定してから、法線で θ=0°面(法線 (0 -1 0))と
// θ=60°面(法線 (-sin60 cos60 0))を選ぶ。
// (羽根はθ=30°の内部バッフルなので放射側面には含まれない)

actions
(
    {
        name    side0Faces;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { patch defaultFaces; }
    }
    {
        name    side0Faces;
        type    faceSet;
        action  subset;
        source  normalToFace;
        sourceInfo { normal (0 -1 0); cos 0.01; }
    }

    {
        name    side60Faces;
        type    faceSet;
        action  new;
        source  patchToFace;
        sourceInfo { patch defaultFaces; }
    }
    {
        name    side60Faces;
        type    faceSet;
        action  subset;
        source  normalToFace;
        sourceInfo { normal (-0.8660254 0.5 0); cos 0.01; }
    }
);

// ************************************************************************* //
