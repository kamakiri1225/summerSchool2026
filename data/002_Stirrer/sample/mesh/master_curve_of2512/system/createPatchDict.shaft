FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// シャフト面を defaultFaces から取り出し、type wall の shaft パッチにする。

pointSync false;

patches
(
    {
        name shaft;
        patchInfo
        {
            type wall;
            inGroups (wall);
        }
        constructFrom set;
        set shaftFaces;
    }
);

// ************************************************************************* //
