FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functions;
}

#includeFunc residuals(name=residuals, fields=(p U))

inletFlowRate
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    log             true;
    writeFields     false;
    writeControl    timeStep;
    writeInterval   1;
    patch           inlet;
    operation       sum;
    fields          (phi);
}

outletFlowRate
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    log             true;
    writeFields     false;
    writeControl    timeStep;
    writeInterval   1;
    patch           outlet;
    operation       sum;
    fields          (phi);
}

